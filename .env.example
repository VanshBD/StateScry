# StateScry local core requires no credentials.
# Optional browser configuration:
STATESCRY_HEADLESS=true
STATESCRY_BROWSER=chromium
STATESCRY_MAX_STATES=100
STATESCRY_MAX_DEPTH=8

# Optional path to a Playwright storage-state JSON file for authenticated mapping.
# STATESCRY_STORAGE_STATE=.statescry/auth/user.json

# Optional comma-separated extra origins the explorer may visit.
# STATESCRY_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Publishing and external integrations are optional and are not read by the core.
# GitHub Actions provides GITHUB_TOKEN automatically when a workflow needs it.
# NPM_TOKEN is needed only by maintainers publishing packages to npm.
# NPM_TOKEN=
