{
  "name": "@statescry-tool/cli",
  "version": "2.0.3",
  "description": "StateScry command-line interface and local dashboard server.",
  "license": "Apache-2.0",
  "keywords": [
    "playwright",
    "behavior-testing",
    "cli",
    "mcp"
  ],
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "bin": {
    "cli": "./dist/bin.js",
    "statescry": "./dist/bin.js",
    "statescry-tool": "./dist/bin.js"
  },
  "main": "./dist/bin.js",
  "files": [
    "dist",
    "public",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@statescry-tool/core": "workspace:*",
    "@statescry-tool/mcp": "workspace:*",
    "@statescry-tool/sdk": "workspace:*",
    "commander": "^14.0.0",
    "typescript": "^5.8.3"
  },
  "devDependencies": {
    "@types/node": "^24.0.15"
  },
  "engines": {
    "node": ">=24"
  }
}
